{
  "name": "coreastro-gpt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.20.0",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:e2e": "cross-env VITE_SHOW_PRESETS=true vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.standard.config.ts",
    "test:calculation-validation": "vitest run src/engine/validation/calculationValidation.test.ts",
    "test:temporal-validation": "vitest run src/engine/validation/temporalCalculationValidation.test.ts",
    "test:pr8-acceptance": "vitest run src/release/pr8AcceptanceReport.test.ts",
    "test:bundle": "vitest run --config vite.bundle.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "verify": "npm run lint && npm test && npm run verify:bundle",
    "verify:release": "node scripts/release/run-release-gate.mjs",
    "verify:bundle": "npm run build && npm run test:bundle",
    "test:pba10": "vitest run src/product/analysis/selectedPeriodProductService.test.ts src/product/analysis/productAnalysisMapper.test.ts src/product/analysis/productAnalysisService.integration.test.ts src/product/analysis/__tests__/productAnalysisService.test.ts src/ai/product/aiExplanationService.test.ts src/pages/__tests__/DashaPage.test.tsx",
    "verify:pba10": "npm run lint && npm run test:pba10 && npm run build",
    "test:e2e": "npm run build:e2e && node node_modules/@playwright/test/cli.js test && node scripts/acceptance/verify-e2e-results.mjs",
    "test:e2e:critical": "npm run test:e2e",
    "test:e2e:report": "playwright show-report",
    "acceptance:report": "node scripts/acceptance/generate-acceptance-report.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
